---
import Layout from '~/layouts/PageLayout.astro';
import { program } from '~/data/program';

const metadata = { title: 'Privacy Policy' };
---

<!-- DRAFT — plain-language privacy summary. Have it reviewed before launch. -->
<Layout metadata={metadata}>
  <article class="prose prose-lg mx-auto max-w-3xl px-4 py-12 prose-headings:font-heading md:py-16">
    <h1>Privacy Policy</h1>
    <p><em>Hearts in Action — {program.city}</em></p>

    <h2>What we collect</h2>
    <p>
      When you register we collect your child’s name, age, grade and any medical or allergy notes, plus your name,
      email, phone number and an emergency contact.
    </p>

    <h2>How we use it</h2>
    <p>
      We use this information only to run the program: confirming your spot, keeping your child safe, contacting you
      about sessions and reaching your emergency contact if needed. We never sell your information.
    </p>

    <h2>Who handles it</h2>
    <p>
      Registration details are delivered to us by our form provider (Web3Forms). Credit card payments are processed by
      Stripe; we never see or store your card number.
    </p>

    <h2>Your choices</h2>
    <p>
      You can ask to see, correct or delete your information at any time by emailing
      <a href={`mailto:${program.contactEmail}`}>{program.contactEmail}</a>.
    </p>
  </article>
</Layout>
