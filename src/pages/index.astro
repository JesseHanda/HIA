---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/hia/Hero.astro';
import ChalloMeaning from '~/components/hia/ChalloMeaning.astro';
import Outcomes from '~/components/hia/Outcomes.astro';
import Gallery from '~/components/hia/Gallery.astro';
import Curriculum from '~/components/hia/Curriculum.astro';
import Logistics from '~/components/hia/Logistics.astro';
import Educator from '~/components/hia/Educator.astro';
import Faq from '~/components/hia/Faq.astro';
import Upcoming from '~/components/hia/Upcoming.astro';
import FinalCta from '~/components/hia/FinalCta.astro';
import EnquiryModal from '~/components/hia/EnquiryModal.astro';
import StickyRegister from '~/components/hia/StickyRegister.astro';
import { program, educator, placeholderWarnings } from '~/data/program';

const placeholders = placeholderWarnings();
if (placeholders.length) {
  console.warn(`[challo] Add confirmed values in src/data/program.ts before launch: ${placeholders.join(', ')}`);
}

const metadata = {
  title: 'CHALLO Kids Club — Character Enrichment Program for Grades 1–3',
  ignoreTitleTemplate: true,
  description: program.intro,
};

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'CHALLO Kids Club — Character Enrichment Program',
  description: metadata.description,
  provider: { '@type': 'Person', name: educator.name },
  educationalLevel: program.grades,
};
---

<Layout metadata={metadata}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />

  <Hero />
  <ChalloMeaning />
  <Outcomes />
  <Gallery />
  <Curriculum />
  <Logistics />
  <Educator />
  <Faq />
  <Upcoming />
  <FinalCta />
  <StickyRegister />
  <EnquiryModal />
</Layout>
