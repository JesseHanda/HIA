---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { challo } from '~/data/program';
---

<WidgetWrapper id="challo" containerClass="max-w-6xl" tone="rose">
  <Headline title="What does CHALLO stand for?" />

  <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      challo.map((c) => (
        <li class="flex items-center gap-5 rounded-3xl bg-white p-5 shadow-md shadow-rose-900/5 ring-1 ring-rose-100 md:p-6">
          <span
            class="flex h-16 w-16 flex-none items-center justify-center rounded-full bg-primary font-heading text-4xl font-extrabold text-white"
            aria-hidden="true"
          >
            {c.letter}
          </span>
          <div>
            <h3 class="font-heading text-xl font-bold text-heading">
              <span class="sr-only">{c.letter} — </span>
              {c.word}
            </h3>
            <p class="mt-0.5 text-muted">{c.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</WidgetWrapper>
