---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { sessionSteps as steps } from '~/data/program';

const outcomes = [
  'Notices the good — and the people who make their day brighter',
  'Pauses to ask, “How might someone else feel?”',
  'Finds the courage to take the next brave step',
  'Chooses kind words and kind actions — even when it’s hard',
  'Shares what they’ve learned with family through simple take-home reminder cards',
];
---

<WidgetWrapper id="outcomes" containerClass="max-w-6xl">
  <Headline
    title="Character isn’t just taught here — it’s practised."
    subtitle="Every session follows the same four steps, so kind thinking becomes a kind habit."
  />

  <ol class="grid gap-0 lg:grid-cols-4 lg:gap-4">
    {
      steps.map((s, i) => (
        <li
          class:list={[
            'relative flex items-start gap-4 pb-7 lg:flex-col lg:items-center lg:gap-0 lg:pb-0 lg:text-center',
            i < steps.length - 1 &&
              "before:absolute before:left-6 before:top-12 before:h-[calc(100%-2.5rem)] before:w-px before:bg-rose-200 before:content-[''] lg:before:left-[calc(50%+2rem)] lg:before:top-6 lg:before:h-px lg:before:w-[calc(100%-4rem+1rem)]",
          ]}
        >
          <span class="relative z-10 flex h-12 w-12 flex-none items-center justify-center rounded-full bg-white text-primary shadow-sm shadow-rose-900/10 ring-1 ring-rose-200">
            <Icon name={s.icon} class="h-6 w-6" />
          </span>
          <div class="lg:mt-4">
            <p class="font-heading text-xl font-bold tracking-wide text-heading">{s.word}</p>
            <p class="text-sm text-muted lg:mx-auto lg:max-w-[14rem]">{s.text}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="mt-10 rounded-3xl bg-rose-50 p-6 ring-1 ring-rose-200 md:mt-14 md:p-9">
    <h3 class="font-heading text-xl font-bold text-heading md:text-2xl">
      Activity pages, reminder cards and a certificate
    </h3>
    <ul class="mt-4 space-y-2.5 text-default">
      <li class="flex items-start gap-3">
        <Icon name="tabler:notebook" class="mt-0.5 h-5 w-5 flex-none text-primary" />
        <span>Children complete age-appropriate activity pages, collected into a booklet.</span>
      </li>
      <li class="flex items-start gap-3">
        <Icon name="tabler:cards" class="mt-0.5 h-5 w-5 flex-none text-primary" />
        <span>Children receive simple take-home reminder cards to share their learning with their families.</span>
      </li>
      <li class="flex items-start gap-3">
        <Icon name="tabler:certificate" class="mt-0.5 h-5 w-5 flex-none text-primary" />
        <span>Every child receives a certificate at the end of the program.</span>
      </li>
      <li class="flex items-start gap-3">
        <Icon name="tabler:home-heart" class="mt-0.5 h-5 w-5 flex-none text-primary" />
        <span>Families get optional everyday ways to practise the values together.</span>
      </li>
    </ul>
    <p
      class="mt-5 inline-flex items-center gap-2 rounded-full bg-white px-4 py-1.5 font-heading text-lg font-bold text-primary ring-1 ring-rose-200"
    >
      <Icon name="tabler:ban" class="h-5 w-5" />
      No homework
    </p>
  </div>

  <div class="mt-6 rounded-3xl bg-green-50 p-6 ring-1 ring-green-200 md:p-9">
    <h3 class="font-heading text-xl font-bold text-heading md:text-2xl">Over eight weeks, your child…</h3>
    <ul class="mt-5 grid gap-x-10 gap-y-3.5 md:grid-cols-2">
      {
        outcomes.map((o) => (
          <li class="flex items-start gap-3 text-default">
            <Icon name="tabler:circle-check-filled" class="mt-0.5 h-5 w-5 flex-none text-accent" />
            <span>{o}</span>
          </li>
        ))
      }
    </ul>
  </div>
</WidgetWrapper>
