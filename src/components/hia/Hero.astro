---
import { Icon } from 'astro-icon/components';
import VideoShowcase from './VideoShowcase.astro';
import EnquiryButtons from './EnquiryButtons.astro';
import { program, safety, educator, integrations } from '~/data/program';

const hasVideo = Boolean(integrations.videoEmbedUrl);

const trust = [
  { icon: 'tabler:users-group', label: `Small groups, max ${program.maxGroupSize}` },
  { icon: 'tabler:first-aid-kit', label: 'Allergy notes kept on hand' },
  { icon: 'tabler:school', label: educator.badge },
  { icon: 'tabler:package', label: 'All materials provided' },
  ...(safety.backgroundChecked ? [{ icon: 'tabler:shield-check', label: 'Background-checked facilitator' }] : []),
];
---

<section class="relative overflow-hidden not-prose">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-rose-50 via-white to-transparent" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-10 md:px-6 md:py-14 lg:grid-cols-2 lg:gap-14 lg:py-20">
    <div class="text-center lg:text-left">
      <p class="text-sm font-bold uppercase tracking-wide text-secondary md:text-base">
        {program.name} · {program.descriptor}
      </p>
      <h1
        class="mt-3 font-heading text-4xl font-extrabold leading-[1.1] tracking-tight text-heading text-balance md:text-5xl lg:text-6xl"
      >
        Instilling kindness, <span class="text-primary">one heart at a time.</span>
      </h1>
      <p class="mt-4 text-base font-semibold text-secondary md:text-lg">
        {program.sessions}-week program · {program.grades}
      </p>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted text-pretty lg:mx-0 md:text-xl">
        {program.intro}
      </p>

      <EnquiryButtons class="mt-8 items-center sm:justify-center lg:justify-start" heroCta />
      <p class="mt-4 text-sm font-medium text-muted">{program.upcomingNote}</p>

      <ul
        class="mx-auto mt-8 grid max-w-xl grid-cols-1 gap-x-6 gap-y-2.5 text-left text-[0.95rem] font-medium text-default min-[420px]:grid-cols-2 lg:mx-0"
        aria-label="Why parents choose us"
      >
        {
          trust.map((b) => (
            <li class="flex items-center gap-2.5">
              <Icon name={b.icon} class="h-5 w-5 flex-none text-accent" />
              {b.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative mx-auto w-full max-w-xl lg:max-w-none">
      {
        hasVideo ? (
          <VideoShowcase />
        ) : (
          <div class="flex aspect-[4/3] w-full items-center justify-center rounded-[2rem] bg-white p-6 shadow-xl shadow-rose-900/10 ring-1 ring-rose-900/10 sm:p-10">
            <img
              src="/challo-logo.svg"
              alt="CHALLO Kids Club — Character Enrichment Program. Instilling kindness, one heart at a time."
              width="1785"
              height="810"
              class="h-auto w-full"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
