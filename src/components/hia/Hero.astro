---
import { Icon } from 'astro-icon/components';
import Button from '~/components/ui/Button.astro';
import VideoShowcase from './VideoShowcase.astro';
import { program, pricing, safety } from '~/data/program';

const badges = [
  { icon: 'tabler:users-group', label: `Small groups · max ${program.maxGroupSize}` },
  { icon: 'tabler:mood-smile', label: 'Beginner friendly' },
  { icon: 'tabler:school', label: 'AMS-trained Montessori educator' },
  { icon: 'tabler:package', label: 'All materials included' },
  ...(safety.backgroundChecked ? [{ icon: 'tabler:shield-check', label: 'Background-checked facilitator' }] : []),
];
---

<section class="relative overflow-hidden not-prose">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-rose-50 via-amber-50/60 to-transparent" aria-hidden="true">
  </div>
  <div class="absolute -right-24 -top-24 -z-10 h-96 w-96 rounded-full bg-rose-200/40 blur-3xl" aria-hidden="true"></div>
  <div class="absolute -left-24 top-1/2 -z-10 h-80 w-80 rounded-full bg-green-200/40 blur-3xl" aria-hidden="true"></div>

  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-12 md:px-6 md:py-16 lg:grid-cols-2 lg:gap-14 lg:py-24">
    <div class="text-center lg:text-left">
      <p
        class="mb-5 inline-flex items-center gap-2 rounded-full border border-rose-200 bg-white/80 px-4 py-1.5 text-sm font-semibold text-secondary"
      >
        <Icon name="tabler:heart-filled" class="h-4 w-4 text-primary" />
        {program.sessions}-week program · {program.grades} · {program.city}
      </p>
      <h1
        class="font-heading text-4xl font-extrabold leading-[1.1] tracking-tight text-heading text-balance md:text-5xl lg:text-6xl"
      >
        Help your child grow a kind heart — and <span class="text-primary">put it into action.</span>
      </h1>
      <p class="mx-auto mt-6 max-w-xl text-lg text-muted text-pretty lg:mx-0 md:text-xl">
        In {program.sessions} weekly sessions, children plant seeds, build a living garden and practise gratitude, kindness,
        empathy and courage — so they learn that even small actions make a difference.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
        <Button
          variant="primary"
          text="Register Now"
          href="#register"
          icon="tabler:arrow-right"
          class="w-full px-8 py-4 text-lg shadow-lg shadow-rose-500/25 sm:w-auto"
          data-open-register
        />
        <Button text="See the 8-week journey" href="#curriculum" class="w-full sm:w-auto" />
      </div>
      <p class="mt-4 text-sm text-muted">
        {pricing.base} + HST per child ({pricing.total} total) · Limited to {program.maxGroupSize} children per group
      </p>

      <ul class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start" aria-label="Why parents choose us">
        {
          badges.map((b) => (
            <li class="inline-flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm font-medium text-default shadow-sm">
              <Icon name={b.icon} class="h-4 w-4 text-accent" />
              {b.label}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="relative">
      <VideoShowcase />
      <div
        class="absolute -bottom-5 left-4 hidden rotate-[-3deg] rounded-2xl bg-white px-4 py-3 shadow-xl ring-1 ring-black/5 sm:block"
      >
        <p class="text-xs font-semibold uppercase tracking-wide text-accent">The big idea</p>
        <p class="font-heading text-lg font-bold text-heading">The world is bigger than me.</p>
      </div>
    </div>
  </div>
</section>
