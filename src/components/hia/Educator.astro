---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { program, safety, educator } from '~/data/program';

// EDIT: add a real photo — save it as /public/educator.jpg and set this to '/educator.jpg'.
const photo = '';

const safetyItems = [
  {
    icon: 'tabler:users-group',
    title: `Small groups of ${program.maxGroupSize} or fewer`,
    text: 'Every child is seen, heard and included.',
  },
  {
    icon: 'tabler:first-aid-kit',
    title: 'Allergy & medical notes on hand',
    text: 'Collected when your child is enrolled and kept with us at every session.',
  },
  {
    icon: 'tabler:phone-call',
    title: 'Emergency contact on file',
    text: 'We can reach you right away if anything comes up.',
  },
  {
    icon: 'tabler:door-enter',
    title: 'Clear drop-off & pick-up',
    text: 'You’ll receive simple, written instructions before the first session.',
  },
  ...(safety.backgroundChecked
    ? [
        {
          icon: 'tabler:shield-check',
          title: 'Background-checked facilitator',
          text: 'Your child is in safe, vetted hands.',
        },
      ]
    : []),
  ...(safety.firstAidCertified
    ? [{ icon: 'tabler:heartbeat', title: 'First-aid certified', text: 'Prepared for the unexpected.' }]
    : []),
];
---

<WidgetWrapper id="educator" containerClass="max-w-6xl">
  <Headline
    title="Created and led by a trained Montessori educator"
    subtitle="A calm, respectful, hands-on approach to helping children grow in character."
  />

  <div class="grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:gap-12">
    <div class="rounded-3xl bg-white p-6 shadow-md shadow-rose-900/5 ring-1 ring-rose-100 md:p-8">
      <div class="flex items-center gap-5">
        {
          photo ? (
            <img src={photo} alt={educator.name} class="h-28 w-24 flex-none rounded-t-full object-cover" />
          ) : (
            <div class="flex-none text-center">
              <div
                class="flex h-28 w-24 items-end justify-center rounded-t-full bg-gradient-to-b from-rose-100 to-amber-50 pb-5 font-heading text-3xl font-extrabold text-secondary ring-1 ring-rose-200"
                aria-hidden="true"
              >
                {educator.initials}
              </div>
            </div>
          )
        }
        <div>
          <h3 class="font-heading text-2xl font-bold text-heading">{educator.name}</h3>
          <p class="font-medium text-accent">{educator.credential}</p>
          <p class="text-sm text-muted">{educator.role} · {program.city}</p>
        </div>
      </div>

      <div class="mt-6 space-y-4 text-default">
        <p>
          Rekha created CHALLO Kids Club to give children meaningful opportunities to practise gratitude, kindness,
          empathy and courage — not just talk about them. Her Montessori training shapes every session: children learn
          by doing, in a calm, respectful space where each voice matters.
        </p>
        <blockquote class="rounded-2xl bg-rose-50 p-5 font-heading text-xl font-semibold leading-snug text-heading">
          <Icon name="tabler:quote-filled" class="mb-2 h-6 w-6 text-rose-300" />
          Kindness isn’t just something we teach. It’s something we instill.
        </blockquote>
      </div>
    </div>

    <div>
      <h3 class="mb-4 flex items-center gap-2 font-heading text-xl font-bold text-heading">
        <Icon name="tabler:shield-heart" class="h-6 w-6 text-primary" />
        Safety &amp; supervision
      </h3>
      <ul class="divide-y divide-green-200/80 rounded-3xl bg-green-50 px-5 ring-1 ring-green-200 md:px-6">
        {
          safetyItems.map((s) => (
            <li class="flex gap-4 py-4">
              <Icon name={s.icon} class="mt-0.5 h-6 w-6 flex-none text-accent" />
              <div>
                <p class="font-semibold leading-snug text-heading">{s.title}</p>
                <p class="mt-0.5 text-sm text-muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</WidgetWrapper>
