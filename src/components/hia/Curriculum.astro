---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { weeks } from '~/data/program';

const rhythm = [
  { icon: 'tabler:messages', label: 'Welcome & conversation' },
  { icon: 'tabler:book-2', label: 'Story & discussion' },
  { icon: 'tabler:hand-click', label: 'Interactive experience' },
  { icon: 'tabler:palette', label: 'Create & add to the garden' },
  { icon: 'tabler:target-arrow', label: 'Hearts in Action Challenge' },
];
---

<WidgetWrapper id="curriculum" containerClass="max-w-6xl">
  <Headline
    title="One quality each week. One new part of the garden."
    subtitle="Children help build a portable Hearts in Action Garden that grows alongside them — a visual reminder that character grows over time."
  />

  <div class="grid gap-8 lg:grid-cols-[1fr_1.6fr] lg:gap-12">
    <div class="order-2 space-y-6 lg:sticky lg:top-24 lg:order-1 lg:self-start">
      <div class="rounded-3xl bg-green-50 p-6 ring-1 ring-green-200">
        <h3 class="flex items-center gap-2 font-heading text-xl font-bold text-heading">
          <Icon name="tabler:flower" class="h-6 w-6 text-accent" />
          Inside every 60-minute session
        </h3>
        <ol class="mt-4 space-y-3">
          {
            rhythm.map((r) => (
              <li class="flex items-center gap-3 text-default">
                <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-white text-accent shadow-sm">
                  <Icon name={r.icon} class="h-5 w-5" />
                </span>
                <span class="font-medium">{r.label}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="rounded-3xl bg-rose-50 p-6 ring-1 ring-rose-200">
        <h3 class="flex items-center gap-2 font-heading text-xl font-bold text-heading">
          <Icon name="tabler:gift" class="h-6 w-6 text-primary" />
          Every week, children take home
        </h3>
        <p class="mt-2 text-muted">
          A simple keepsake or experience that helps them remember the lesson — plus a Hearts in Action Challenge to try
          with family. Week 8 ends with a Hearts in Action Certificate.
        </p>
      </div>
    </div>

    <div class="order-1 space-y-3 lg:order-2" data-curriculum>
      {
        weeks.map((w, i) => (
          <details
            name="hia-week"
            open={i === 0}
            class="group overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm open:border-rose-300 open:shadow-md motion-safe:transition"
          >
            <summary class="flex cursor-pointer list-none items-center gap-4 p-4 sm:p-5 [&::-webkit-details-marker]:hidden">
              <span class="flex h-12 w-12 flex-none flex-col items-center justify-center rounded-xl bg-rose-50 text-primary">
                <span class="text-xs font-bold uppercase leading-none text-secondary">Week</span>
                <span class="font-heading text-xl font-extrabold leading-none">{w.n}</span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block font-heading text-lg font-bold leading-tight text-heading">{w.theme}</span>
                <span class="block text-sm text-muted">{w.title}</span>
              </span>
              <span class="hidden flex-none items-center gap-1.5 rounded-full bg-green-50 px-3 py-1 text-xs font-semibold text-accent sm:inline-flex">
                <Icon name={w.icon} class="h-4 w-4" />
                {w.garden}
              </span>
              <Icon
                name="tabler:chevron-down"
                class="h-5 w-5 flex-none text-muted transition-transform group-open:rotate-180"
              />
            </summary>
            <div class="space-y-3 border-t border-gray-100 px-4 pb-5 pt-4 sm:px-5">
              <p class="text-default">{w.text}</p>
              <p class="flex gap-2 text-sm text-muted">
                <Icon name="tabler:hand-click" class="mt-0.5 h-4 w-4 flex-none text-primary" />
                <span>
                  <strong class="text-heading">What children do:</strong> {w.doing}
                </span>
              </p>
              <p class="flex gap-2 text-sm text-muted sm:hidden">
                <Icon name={w.icon} class="mt-0.5 h-4 w-4 flex-none text-accent" />
                <span>
                  <strong class="text-heading">Garden piece:</strong> {w.garden}
                </span>
              </p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</WidgetWrapper>
