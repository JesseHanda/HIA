---
import { Icon } from 'astro-icon/components';
import { integrations, etransfer, pricing, program } from '~/data/program';

const input =
  'mt-1 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-base text-default shadow-sm placeholder:text-gray-400 focus:border-primary focus:outline-none focus:ring-2 focus:ring-rose-200';
const label = 'block text-sm font-semibold text-heading';
---

<dialog
  id="register-dialog"
  aria-labelledby="register-title"
  class="m-auto max-h-[94dvh] w-[min(44rem,calc(100vw-1rem))] overflow-hidden rounded-3xl border-0 bg-page p-0 text-default shadow-2xl backdrop:bg-black/55 backdrop:backdrop-blur-sm"
  data-stripe-url={integrations.stripePaymentLink}
>
  <div class="flex max-h-[94dvh] flex-col">
    <div class="flex items-start justify-between gap-4 border-b border-gray-200 bg-white px-5 py-4 sm:px-8">
      <div>
        <h2 id="register-title" class="font-heading text-2xl font-extrabold text-heading">
          Register for Hearts in Action
        </h2>
        <p class="text-sm text-muted">
          {program.sessions} weeks · {program.grades} · {pricing.total}
          {pricing.currency} incl. HST
        </p>
      </div>
      <button
        type="button"
        data-close-register
        aria-label="Close registration"
        class="rounded-full p-2 text-muted transition hover:bg-gray-100 hover:text-heading focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      >
        <Icon name="tabler:x" class="h-6 w-6" />
      </button>
    </div>

    <div class="overflow-y-auto px-5 py-6 sm:px-8">
      <form
        id="register-form"
        class="space-y-8"
        data-endpoint={integrations.formEndpoint}
        data-contact={program.contactEmail}
        data-amount={`${pricing.total} ${pricing.currency} (incl. HST)`}
      >
        <!-- WEB3FORMS ACCESS KEY — set `web3formsAccessKey` in src/data/program.ts -->
        <input type="hidden" name="access_key" value={integrations.web3formsAccessKey} />
        <input type="hidden" name="subject" value="New Hearts in Action registration" />
        <input type="hidden" name="from_name" value="Hearts in Action website" />
        <!-- Honeypot: real visitors never see or tick this -->
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

        <fieldset class="space-y-4">
          <legend class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-heading">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-sm text-white">1</span>
            About your child
          </legend>
          <div>
            <label class={label} for="child_name">Child’s full name</label>
            <input class={input} id="child_name" name="child_name" type="text" autocomplete="off" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={label} for="child_age">Age</label>
              <input
                class={input}
                id="child_age"
                name="child_age"
                type="number"
                min="4"
                max="12"
                inputmode="numeric"
                required
              />
            </div>
            <div>
              <label class={label} for="child_grade">Grade</label>
              <select class={input} id="child_grade" name="child_grade" required>
                <option value="" disabled selected>Select grade</option>
                <option>Grade 1</option>
                <option>Grade 2</option>
                <option>Grade 3</option>
                <option>Other (please note below)</option>
              </select>
            </div>
          </div>
          <div>
            <label class={label} for="medical_notes">
              Medical / allergy notes <span class="font-normal text-muted">(write “None” if not applicable)</span>
            </label>
            <textarea
              class={input}
              id="medical_notes"
              name="medical_notes"
              rows="3"
              placeholder="Allergies, medications, anything we should know to keep your child safe"
              required></textarea>
          </div>
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-heading">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-sm text-white">2</span>
            Parent / guardian
          </legend>
          <div>
            <label class={label} for="parent_name">Full name</label>
            <input class={input} id="parent_name" name="parent_name" type="text" autocomplete="name" required />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={label} for="email">Email</label>
              <input class={input} id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label class={label} for="phone">Phone number</label>
              <input class={input} id="phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class={label} for="emergency_name">Emergency contact name</label>
              <input class={input} id="emergency_name" name="emergency_contact_name" type="text" required />
            </div>
            <div>
              <label class={label} for="emergency_phone">Emergency contact phone</label>
              <input class={input} id="emergency_phone" name="emergency_contact_phone" type="tel" required />
            </div>
          </div>
        </fieldset>

        <fieldset class="space-y-4">
          <legend class="mb-3 flex items-center gap-2 font-heading text-lg font-bold text-heading">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary text-sm text-white">3</span>
            How would you like to pay?
          </legend>
          <div class="grid gap-3 sm:grid-cols-2">
            <label
              class="flex cursor-pointer gap-3 rounded-2xl border-2 border-gray-200 bg-white p-4 transition has-[:checked]:border-primary has-[:checked]:bg-rose-50/60 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-rose-300"
            >
              <input
                type="radio"
                name="payment_method"
                value="Credit Card"
                class="mt-1 h-4 w-4 accent-rose-600"
                checked
              />
              <span>
                <span class="flex items-center gap-2 font-semibold text-heading">
                  <Icon name="tabler:credit-card" class="h-5 w-5 text-primary" /> Credit card
                </span>
                <span
                  class="mt-0.5 inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-0.5 text-xs font-bold text-green-800"
                >
                  <Icon name="tabler:bolt" class="h-3 w-3" /> Instant Confirmation
                </span>
              </span>
            </label>
            <label
              class="flex cursor-pointer gap-3 rounded-2xl border-2 border-gray-200 bg-white p-4 transition has-[:checked]:border-primary has-[:checked]:bg-rose-50/60 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-rose-300"
            >
              <input
                type="radio"
                name="payment_method"
                value="Interac e-Transfer"
                class="mt-1 h-4 w-4 accent-rose-600"
              />
              <span>
                <span class="flex items-center gap-2 font-semibold text-heading">
                  <Icon name="tabler:building-bank" class="h-5 w-5 text-primary" /> Interac e-Transfer
                </span>
                <span
                  class="mt-0.5 inline-flex items-center gap-1 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-bold text-amber-800"
                >
                  <Icon name="tabler:clock-check" class="h-3 w-3" /> Manual Approval
                </span>
              </span>
            </label>
          </div>

          <div data-pay-panel="Credit Card" class="rounded-2xl border border-green-200 bg-green-50/70 p-4 text-sm">
            <p class="font-semibold text-green-900">Instant Confirmation</p>
            <p class="mt-1 text-green-900/80">
              After you submit, you’ll go straight to our secure Stripe checkout to pay {pricing.total}
              {pricing.currency}. Your spot is confirmed the moment payment completes.
            </p>
          </div>

          <div
            data-pay-panel="Interac e-Transfer"
            hidden
            class="rounded-2xl border border-amber-200 bg-amber-50/80 p-4 text-sm"
          >
            <p class="font-semibold text-amber-900">Manual Approval — your spot is held while we verify</p>
            <p class="mt-1 text-amber-900/80">
              Submit this form to hold your spot for {etransfer.holdHours} hours. Then send an Interac e-Transfer with these
              details:
            </p>
            <dl class="mt-3 grid gap-x-4 gap-y-1 rounded-xl bg-white/80 p-3 text-amber-950 sm:grid-cols-[auto_1fr]">
              <dt class="font-semibold">Send to</dt>
              <dd class="break-all">{etransfer.email}</dd>
              <dt class="font-semibold">Amount</dt>
              <dd>{etransfer.amount}</dd>
              {
                etransfer.securityQuestion && (
                  <>
                    <dt class="font-semibold">Security question</dt>
                    <dd>{etransfer.securityQuestion}</dd>
                    <dt class="font-semibold">Answer</dt>
                    <dd>{etransfer.securityAnswer}</dd>
                  </>
                )
              }
              <dt class="font-semibold">Message / note</dt>
              <dd>Your child’s full name + “Hearts in Action”</dd>
            </dl>
            <p class="mt-3 text-amber-900/80">
              Your spot is <strong>temporarily held</strong> until we verify your transfer, then we’ll email your confirmation.
              If we don’t receive it within {etransfer.holdHours} hours, the spot may be released.
            </p>
          </div>
        </fieldset>

        <div class="space-y-4">
          <label class="flex items-start gap-3 text-sm">
            <input type="checkbox" name="consent" value="Yes" required class="mt-1 h-4 w-4 flex-none accent-rose-600" />
            <span>
              I’m this child’s parent or legal guardian, the information above is accurate, and I agree to the
              <a href="/terms" target="_blank" class="font-semibold text-primary underline">program terms</a>
              and
              <a href="/privacy" target="_blank" class="font-semibold text-primary underline">privacy policy</a>.
            </span>
          </label>

          <p id="register-error" role="alert" hidden class="rounded-xl bg-red-50 p-3 text-sm font-medium text-red-800">
          </p>

          <button
            type="submit"
            id="register-submit"
            class="btn-primary w-full px-8 py-4 text-lg shadow-lg shadow-rose-500/25 disabled:cursor-wait disabled:opacity-70"
          >
            <span data-submit-label>Continue to Secure Payment</span>
            <Icon name="tabler:lock" class="ml-2 h-5 w-5" />
          </button>
          <p class="text-center text-xs text-muted">
            Your details are used only to run the program. Questions? {program.contactEmail}
          </p>
        </div>
      </form>

      <!-- Success: credit card -->
      <div id="register-success-card" hidden class="py-6 text-center" role="status">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100 text-accent">
          <Icon name="tabler:circle-check-filled" class="h-10 w-10" />
        </span>
        <h3 class="mt-4 font-heading text-2xl font-extrabold text-heading">Registration received!</h3>
        <p class="mx-auto mt-2 max-w-md text-muted">
          One last step — complete your payment to confirm your child’s spot instantly. We’re taking you to secure
          checkout now.
        </p>
        <!-- STRIPE PAYMENT LINK URL — set `stripePaymentLink` in src/data/program.ts -->
        <a
          id="stripe-link"
          href={integrations.stripePaymentLink}
          class="btn-primary mt-6 px-8 py-4 text-lg"
          rel="noopener"
        >
          Pay {pricing.total} securely with Stripe
          <Icon name="tabler:arrow-right" class="ml-2 h-5 w-5" />
        </a>
      </div>

      <!-- Success: e-Transfer -->
      <div id="register-success-etransfer" hidden class="py-6 text-center" role="status">
        <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-amber-100 text-amber-600">
          <Icon name="tabler:clock-check" class="h-10 w-10" />
        </span>
        <h3 class="mt-4 font-heading text-2xl font-extrabold text-heading">Your spot is being held</h3>
        <p class="mx-auto mt-2 max-w-md text-muted">Thank you! Next, please send your Interac e-Transfer:</p>
        <dl
          class="mx-auto mt-3 grid max-w-md gap-x-4 gap-y-1 rounded-xl border border-amber-200 bg-amber-50/80 p-4 text-left text-sm text-amber-950 sm:grid-cols-[auto_1fr]"
        >
          <dt class="font-semibold">Send to</dt>
          <dd class="break-all">{etransfer.email}</dd>
          <dt class="font-semibold">Amount</dt>
          <dd>{etransfer.amount}</dd>
          {
            etransfer.securityQuestion && (
              <>
                <dt class="font-semibold">Security question</dt>
                <dd>{etransfer.securityQuestion}</dd>
                <dt class="font-semibold">Answer</dt>
                <dd>{etransfer.securityAnswer}</dd>
              </>
            )
          }
          <dt class="font-semibold">Message / note</dt>
          <dd>Your child’s full name + “Hearts in Action”</dd>
        </dl>
        <p class="mx-auto mt-3 max-w-md text-muted">
          Your spot is <strong>temporarily held</strong> for {etransfer.holdHours} hours while we verify the transfer. We’ll
          email your confirmation as soon as it arrives.
        </p>
        <button type="button" data-close-register class="btn-secondary mt-6">Close</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.getElementById('register-dialog') as HTMLDialogElement | null;
  const form = document.getElementById('register-form') as HTMLFormElement | null;

  if (dialog && form) {
    const errorBox = document.getElementById('register-error') as HTMLElement;
    const submit = document.getElementById('register-submit') as HTMLButtonElement;
    const submitLabel = submit.querySelector('[data-submit-label]') as HTMLElement;
    const successCard = document.getElementById('register-success-card') as HTMLElement;
    const successEt = document.getElementById('register-success-etransfer') as HTMLElement;
    const stripeLink = document.getElementById('stripe-link') as HTMLAnchorElement;
    const panels = dialog.querySelectorAll<HTMLElement>('[data-pay-panel]');

    const open = () => {
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add('overflow-hidden');
      if (location.hash !== '#register') history.replaceState(null, '', '#register');
    };
    const close = () => {
      dialog.close();
    };

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('overflow-hidden');
      if (location.hash === '#register') history.replaceState(null, '', location.pathname + location.search);
    });

    // Open from any trigger
    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('[data-open-register], a[href="#register"], a[href$="/#register"]')) {
        e.preventDefault();
        open();
      } else if (target.closest('[data-close-register]')) {
        close();
      } else if (target === dialog) {
        close(); // click on the backdrop
      }
    });
    if (location.hash === '#register') open();

    // Payment method switching
    const paymentMethod = () => (form.elements.namedItem('payment_method') as RadioNodeList).value;
    const syncPayment = () => {
      const method = paymentMethod();
      panels.forEach((p) => (p.hidden = p.dataset.payPanel !== method));
      submitLabel.textContent = method === 'Credit Card' ? 'Continue to Secure Payment' : 'Reserve My Spot';
    };
    form.addEventListener('change', (e) => {
      if ((e.target as HTMLInputElement).name === 'payment_method') syncPayment();
    });
    syncPayment();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;
      submit.disabled = true;
      const original = submitLabel.textContent;
      submitLabel.textContent = 'Submitting…';

      const data = Object.fromEntries(new FormData(form).entries());
      // Honeypot tripped: silently pretend success
      if (data.botcheck) {
        submit.disabled = false;
        submitLabel.textContent = original;
        return;
      }
      delete data.botcheck;
      const method = String(data.payment_method);
      data.amount_due = form.dataset.amount as string;
      data.subject = `New registration (${method}): ${data.child_name}`;
      data.replyto = String(data.email);

      try {
        const res = await fetch(form.dataset.endpoint as string, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        if (!res.ok || json.success === false) throw new Error(json.message || 'Submission failed');

        form.hidden = true;
        dialog.querySelector('.overflow-y-auto')?.scrollTo({ top: 0 });
        if (method === 'Credit Card') {
          const url = new URL(stripeLink.href, location.href);
          url.searchParams.set('prefilled_email', String(data.email));
          stripeLink.href = url.toString();
          successCard.hidden = false;
          setTimeout(() => location.assign(url.toString()), 1800);
        } else {
          successEt.hidden = false;
        }
      } catch (err) {
        errorBox.textContent = `Sorry — we couldn’t submit your registration just now. Please try again, or email ${form.dataset.contact} and we’ll register you by hand.`;
        errorBox.hidden = false;
        submit.disabled = false;
        submitLabel.textContent = original;
        console.error(err);
      }
    });
  }
</script>
