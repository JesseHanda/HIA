---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import { faqs, program } from '~/data/program';

// FAQPage structured data for search engines
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<WidgetWrapper id="faq" containerClass="max-w-3xl">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
  <Headline title="Questions parents ask us" subtitle="Can’t find your answer? We’re always happy to help." />

  <div class="space-y-3">
    {
      faqs.map((f) => (
        <details class="group rounded-2xl border border-gray-200 bg-white shadow-sm open:border-rose-300 open:shadow-md motion-safe:transition">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 font-heading text-lg font-bold text-heading [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon
              name="tabler:chevron-down"
              class="h-5 w-5 flex-none text-muted transition-transform group-open:rotate-180"
            />
          </summary>
          <p class="px-5 pb-5 text-default">{f.a}</p>
        </details>
      ))
    }
  </div>

  <p class="mt-8 text-center text-muted">
    Still wondering about something? Email
    <a class="font-semibold text-secondary hover:underline" href={`mailto:${program.contactEmail}`}>
      {program.contactEmail}
    </a>
    or call {program.contactPhone}.
  </p>
</WidgetWrapper>
