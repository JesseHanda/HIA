---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Art from './Art.astro';
import { gallery } from '~/data/program';

const tones: Record<string, string> = {
  rose: 'bg-rose-100',
  green: 'bg-green-100',
  cream: 'bg-amber-50',
};
---

<!--
  GALLERY — replace the illustrated placeholders with real photos:
  put images in /public/gallery/ and set `src` on the matching entry in src/data/program.ts.
-->
<WidgetWrapper id="gallery" containerClass="max-w-6xl" tone="green">
  <Headline
    title="Hands-on, joyful and unforgettable"
    subtitle="Children learn by doing — talking, creating and reflecting together."
  />

  <div
    class="-mx-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] sm:mx-0 sm:overflow-visible sm:px-0 sm:pb-0"
    role="group"
    aria-label="Program highlights. Scroll sideways to see them all."
    tabindex="0"
  >
    <ul class="flex snap-x snap-mandatory gap-4 sm:grid sm:grid-cols-3 sm:gap-5">
      {
        gallery.map((g) => (
          <li class="group w-[78%] flex-none snap-start overflow-hidden rounded-3xl bg-white shadow-md shadow-green-900/5 ring-1 ring-green-900/10 motion-safe:transition-transform motion-safe:duration-300 motion-safe:hover:-translate-y-0.5 sm:w-auto">
            <div class={`relative aspect-[4/3] overflow-hidden ${tones[g.tone] ?? tones.rose}`}>
              {g.src ? (
                <img src={g.src} alt={g.alt ?? g.title} loading="lazy" class="h-full w-full object-cover" />
              ) : (
                <Art name={g.art} class="absolute inset-0 h-full w-full p-5" />
              )}
            </div>
            <div class="p-5">
              <h3 class="font-heading text-lg font-bold text-heading">{g.title}</h3>
              <p class="mt-1 text-sm text-muted">{g.caption}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</WidgetWrapper>
