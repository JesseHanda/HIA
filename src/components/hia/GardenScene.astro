</svg>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .grow {
      transform-box: fill-box;
      transform-origin: 50% 100%;
      animation: grow 1.4s cubic-bezier(0.16, 1, 0.3, 1) var(--d, 0s) both;
    }
    @keyframes grow {
      from {
        opacity: 0;
        transform: scale(0.82) translateY(10px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
