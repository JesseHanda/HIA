  class="h-full w-full"
  role="img"
  aria-label="Illustration of three plants growing from a seed to a heart-shaped bloom"
  fill="none"
  stroke="#3a1a26"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
