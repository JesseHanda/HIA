---
// Small line illustrations used for the gallery placeholders.
import type { GalleryArt } from '~/data/program';

export interface Props {
  name: GalleryArt;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 150"
  class={className}
  aria-hidden="true"
  fill="none"
  stroke="#1A1A1A"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'book' && (
      <>
        <path d="M100 42c-18-10-44-12-66-6v78c22-6 48-4 66 6z" fill="#F7C2C6" />
        <path d="M100 42c18-10 44-12 66-6v78c-22-6-48-4-66 6z" fill="#FDF1F2" />
        <path d="M100 42v78" />
        <path d="M50 58c12-3 24-2 36 2M50 74c12-3 24-2 36 2" stroke-width="2.5" stroke-opacity=".5" />
        <path
          d="M138 66c-10-7-14-13-10-18 3-4 8-2 10 2 2-4 7-6 10-2 4 5 0 11-10 18z"
          fill="#D7202B"
          stroke-width="2.5"
        />
      </>
    )
  }
  {
    name === 'craft' && (
      <>
        <rect x="34" y="34" width="96" height="84" rx="8" fill="#fff" transform="rotate(-4 82 76)" />
        <path d="M52 60c10-10 18 10 28 0s18 10 28 0" stroke="#D7202B" />
        <path d="M52 84h56M52 98h38" stroke-width="2.5" stroke-opacity=".4" />
        <path d="M128 112l34-62 12 6-34 62-16 8z" fill="#fde68a" />
        <path d="M162 50l12 6" />
        <path d="M128 112l-2 14 10-6z" fill="#1A1A1A" />
      </>
    )
  }
  {
    name === 'certificate' && (
      <>
        <rect x="32" y="30" width="136" height="90" rx="8" fill="#fff" />
        <rect x="42" y="40" width="116" height="70" rx="4" stroke-width="2" stroke-opacity=".35" />
        <path d="M62 64h76M74 80h52" stroke-width="2.5" stroke-opacity=".45" />
        <circle cx="100" cy="100" r="13" fill="#D7202B" />
        <path d="M92 112l-4 22 12-7 12 7-4-22" fill="#F09399" />
        <path d="M100 106c-6-4-8-8-6-11 2-2 5-1 6 1 1-2 4-3 6-1 2 3 0 7-6 11z" fill="#fff" stroke-width="2" />
      </>
    )
  }
</svg>
