---
// Small line illustrations used for the gallery placeholders (same hand-drawn language as GardenScene).
import type { GalleryArt } from '~/data/program';

export interface Props {
  name: GalleryArt;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 200 150"
  class={className}
  aria-hidden="true"
  fill="none"
  stroke="#3a1a26"
  stroke-width="3"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'seed' && (
      <>
        <path d="M30 112c40-8 100 8 140-2v28H30z" fill="#e9d5c0" stroke="none" />
        <path d="M30 112c40-8 100 8 140-2" />
        <path d="M100 110V74" />
        <path d="M100 82c-22-2-32-14-32-30 20 0 32 12 32 30z" fill="#86efac" />
        <path d="M100 74c18-2 28-12 28-26-18 0-28 10-28 26z" fill="#bbf7d0" />
        <ellipse cx="64" cy="124" rx="6" ry="4" fill="#b08968" stroke="none" />
      </>
    )
  }
  {
    name === 'book' && (
      <>
        <path d="M100 42c-18-10-44-12-66-6v78c22-6 48-4 66 6z" fill="#fecdd3" />
        <path d="M100 42c18-10 44-12 66-6v78c-22-6-48-4-66 6z" fill="#fff1f2" />
        <path d="M100 42v78" />
        <path d="M50 58c12-3 24-2 36 2M50 74c12-3 24-2 36 2" stroke-width="2.5" stroke-opacity=".5" />
        <path
          d="M138 66c-10-7-14-13-10-18 3-4 8-2 10 2 2-4 7-6 10-2 4 5 0 11-10 18z"
          fill="#fb7185"
          stroke-width="2.5"
        />
      </>
    )
  }
  {
    name === 'garden' && (
      <>
        <rect x="26" y="98" width="148" height="34" rx="10" fill="#e9d5c0" />
        <path d="M60 98V70M100 98V48M140 98V66" />
        <path d="M60 80c-14 0-20-8-20-18 14 0 20 8 20 18z" fill="#86efac" />
        <path d="M100 66c-12 0-18-6-18-14 12 0 18 6 18 14z" fill="#bbf7d0" />
        <path d="M100 52c-20-12-28-26-20-38 7-9 17-5 20 4 3-9 13-13 20-4 8 12 0 26-20 38z" fill="#fb7185" />
        <path d="M140 80c12 0 18-8 18-16-12 0-18 6-18 16z" fill="#bbf7d0" />
        <circle cx="140" cy="60" r="7" fill="#fda4af" />
      </>
    )
  }
  {
    name === 'craft' && (
      <>
        <rect x="34" y="34" width="96" height="84" rx="8" fill="#fff" transform="rotate(-4 82 76)" />
        <path d="M52 60c10-10 18 10 28 0s18 10 28 0" stroke="#fb7185" />
        <path d="M52 84h56M52 98h38" stroke-width="2.5" stroke-opacity=".4" />
        <path d="M128 112l34-62 12 6-34 62-16 8z" fill="#fde68a" />
        <path d="M162 50l12 6" />
        <path d="M128 112l-2 14 10-6z" fill="#3a1a26" />
      </>
    )
  }
  {
    name === 'gift' && (
      <>
        <rect x="46" y="62" width="108" height="64" rx="8" fill="#fecdd3" />
        <rect x="38" y="48" width="124" height="22" rx="8" fill="#fb7185" />
        <path d="M100 48v78" />
        <path d="M100 48c-10-22-34-22-34-8 0 10 20 8 34 8zM100 48c10-22 34-22 34-8 0 10-20 8-34 8z" fill="#fff1f2" />
      </>
    )
  }
  {
    name === 'certificate' && (
      <>
        <rect x="32" y="30" width="136" height="90" rx="8" fill="#fff" />
        <rect x="42" y="40" width="116" height="70" rx="4" stroke-width="2" stroke-opacity=".35" />
        <path d="M62 64h76M74 80h52" stroke-width="2.5" stroke-opacity=".45" />
        <circle cx="100" cy="100" r="13" fill="#fb7185" />
        <path d="M92 112l-4 22 12-7 12 7-4-22" fill="#fda4af" />
        <path d="M100 106c-6-4-8-8-6-11 2-2 5-1 6 1 1-2 4-3 6-1 2 3 0 7-6 11z" fill="#fff" stroke-width="2" />
      </>
    )
  }
</svg>
