---
import type { Headline as Props } from '~/types';
import { twMerge } from 'tailwind-merge';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  classes = {},
} = Astro.props;

const {
  container: containerClass = 'max-w-3xl',
  title: titleClass = 'text-3xl md:text-4xl lg:text-5xl',
  subtitle: subtitleClass = 'text-xl',
} = classes;
---

{
  (title || subtitle) && (
    <div class={twMerge('mb-8 md:mx-auto md:mb-12 text-center', containerClass)}>
      {title && (
        <h2
          class={twMerge(
            'font-extrabold leading-[1.12] tracking-tight font-heading text-heading text-3xl text-balance',
            titleClass
          )}
          set:html={title}
        />
      )}

      {subtitle && (
        <p class={twMerge('mx-auto mt-4 max-w-2xl text-muted text-pretty', subtitleClass)} set:html={subtitle} />
      )}
    </div>
  )
}
