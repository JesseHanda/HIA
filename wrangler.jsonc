// Cloudflare config: the site is fully static, so the Worker only serves the `dist/` folder.
// Works with Cloudflare's Git integration (build: `npm run build`, deploy: `npx wrangler deploy`).
// Docs: https://developers.cloudflare.com/workers/static-assets/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hearts-in-action",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
